---
import Layout from '../../layouts/Layout.astro';
import { catalog } from '../../lib/data';
---
<Layout title="Filmes" section="filmes">
  <div class="page-heading"><h1>Filmes</h1><p class="muted">O acervo, de A a Z.</p></div>
  <ul class="film-grid">{catalog.filmes.map(film => <li><a class="film-card" href={`/filmes/${film.id}/`}><div class="poster"><img src={film.cartaz ?? '/artes/cartaz-provisorio.svg'} alt="" width="270" height="405" />{!film.cartaz && <span>Arte provisória</span>}</div><h2>{film.titulo}</h2><p>{film.duracao ?? 'Duração a definir'}</p><span class="card-arrow" aria-hidden="true">→</span></a></li>)}</ul>
  {!catalog.filmes.length && <p>O primeiro filme está a caminho.</p>}
</Layout>
