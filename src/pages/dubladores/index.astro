---
import Layout from '../../layouts/Layout.astro';
import Avatar from '../../components/Avatar.astro';
import { catalog } from '../../lib/data';
---
<Layout title="Dubladores" section="dubladores">
  <div class="page-heading"><h1>Dubladores</h1><p class="muted">As vozes do acervo, de A a Z.</p></div>
  <ul class="people-grid">{catalog.dubladores.map(person => <li><a href={`/dubladores/${person.id}/`}><Avatar nome={person.nome} foto={person.foto} /><div><h2>{person.nome}</h2><span>Ver perfil</span></div><span class="person-arrow" aria-hidden="true">→</span></a></li>)}</ul>
  {!catalog.dubladores.length && <p>Os primeiros perfis estão a caminho.</p>}
</Layout>
