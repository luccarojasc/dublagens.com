---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Página não encontrada" section="inicio">
  <section class="empty page-heading" data-enter>
    <p class="eyebrow">Erro 404</p>
    <h1>Página não encontrada</h1>
    <p class="heading-intro">O endereço pode ter mudado ou não existe neste acervo.</p>
    <a class="back-link" href="/">Voltar ao início</a>
  </section>
</Layout>
